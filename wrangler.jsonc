{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "ligronlink",

  "main": "src/index.js",

  "compatibility_date": "2026-07-04",

  "workers_dev": true,

  // Pi y Native usan esta URL estable. El subdominio workers.dev queda sólo
  // como acceso técnico; no debe ser la única puerta de la API de producción.
  "routes": [
    { "pattern": "api.ligronair.tv", "custom_domain": true }
  ],

  // Identificadores no secretos del plano LigronTail. Las credenciales OAuth
  // se cargan exclusivamente como secretos de Worker, nunca en este fichero
  // ni en Native.
  "vars": {
    "LIGRONTAIL_TAILNET": "ligronair.github",
    "LIGRONTAIL_DEVICE_TAG": "tag:ligronair-native"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ligronlink-dev",
      "database_id": "451fa705-e956-4936-ad84-00cc328303f9"
    }
  ],

  // R2 queda deliberadamente fuera hasta que exista el bucket de releases.
  // Las rutas de actualización ya responden de forma controlada cuando el
  // binding no está disponible; no debe impedir Pi↔Link↔Native.

  "durable_objects": {
    "bindings": [
      { "name": "NATIVE_CONTROL_HUB", "class_name": "NativeControlHub" }
    ]
  },

  "migrations": [
    { "tag": "v1-native-control-hub", "new_sqlite_classes": ["NativeControlHub"] }
  ]
}
