{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "ligronlink",

  "main": "src/index.js",

  "compatibility_date": "2026-07-04",

  "workers_dev": true,

  // Identificadores no secretos del plano LigronTail. Las credenciales OAuth
  // se cargan exclusivamente como secretos de Worker, nunca en este fichero
  // ni en Native.
  "vars": {
    "LIGRONTAIL_TAILNET": "ligronair.github",
    "LIGRONTAIL_DEVICE_TAG": "tag:ligronair-native"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ligronlink-dev",
      "database_id": "451fa705-e956-4936-ad84-00cc328303f9"
    }
  ]
}
